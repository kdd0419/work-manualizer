{
  "description": "평가 시나리오: 업무 10개 × 입력값 3세트. 데이터 기준일 2026-11-18로 시드한 DB 기준 (python -m mock_system.seed --base-date 2026-11-18).",
  "base_url": "http://localhost:5000",
  "login": {"id": "tester", "password": "pass1234"},
  "notes": [
    "actions: 녹화할 때 사람 대신 자동으로 수행할 동작. 로그인 동작은 자동으로 앞에 붙는다.",
    "input_sets[0]은 녹화 때와 같은 값, [1]·[2]는 다른 값이다. v1(그대로 재생)은 값을 바꿀 수 없어 [1]·[2]에서 실패하는 것이 정상이다.",
    "inputs의 키는 요소 id 또는 name. 매크로에서 그 요소를 쓰는 변수에 값을 넣는다.",
    "expect: download(파일명 목록), message(화면 메시지에 포함될 문구), stop(멈춰야 하는 원인 코드)."
  ],
  "scenarios": [
    {
      "id": "S01", "name": "점검현황_전체조회_다운로드",
      "actions": [
        {"click": "#menu-inspection-status"},
        {"fill": "#inquiry-date", "value": "2026-11-18"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"inquiry-date": "2026-11-18"}, "expect": {"download": ["위탁업체점검_20261118.csv"]}},
        {"inputs": {"inquiry-date": "2026-11-01"}, "expect": {"download": ["위탁업체점검_20261101.csv"]}},
        {"inputs": {"inquiry-date": "2026-10-15"}, "expect": {"download": ["위탁업체점검_20261015.csv"]}}
      ]
    },
    {
      "id": "S02", "name": "점검현황_업체구분별_다운로드",
      "actions": [
        {"click": "#menu-inspection-status"},
        {"fill": "#inquiry-date", "value": "2026-11-18"},
        {"select": "#vendor-category", "value": "IT"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"inquiry-date": "2026-11-18", "vendor-category": "IT"}, "expect": {"download": ["위탁업체점검_20261118.csv"]}},
        {"inputs": {"inquiry-date": "2026-11-10", "vendor-category": "콜센터"}, "expect": {"download": ["위탁업체점검_20261110.csv"]}},
        {"inputs": {"inquiry-date": "2026-10-31", "vendor-category": "보안"}, "expect": {"download": ["위탁업체점검_20261031.csv"]}}
      ]
    },
    {
      "id": "S03", "name": "점검현황_상태별_다운로드",
      "actions": [
        {"click": "#menu-inspection-status"},
        {"fill": "#inquiry-date", "value": "2026-11-18"},
        {"select": "#vendor-status", "value": "적합"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"inquiry-date": "2026-11-18", "vendor-status": "적합"}, "expect": {"download": ["위탁업체점검_20261118.csv"]}},
        {"inputs": {"inquiry-date": "2026-11-05", "vendor-status": "보완 필요"}, "expect": {"download": ["위탁업체점검_20261105.csv"]}},
        {"inputs": {"inquiry-date": "2020-01-01", "vendor-status": "적합"}, "expect": {"stop": "no_result"}}
      ]
    },
    {
      "id": "S04", "name": "거래집계_기간_다운로드",
      "actions": [
        {"click": "#menu-daily-trades"},
        {"fill": "#start-date", "value": "2026-11-01"},
        {"fill": "#end-date", "value": "2026-11-18"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"start-date": "2026-11-01", "end-date": "2026-11-18"}, "expect": {"download": ["일별거래집계_20261101_20261118.csv"]}},
        {"inputs": {"start-date": "2026-10-01", "end-date": "2026-10-31"}, "expect": {"download": ["일별거래집계_20261001_20261031.csv"]}},
        {"inputs": {"start-date": "2026-09-01", "end-date": "2026-09-30"}, "expect": {"download": ["일별거래집계_20260901_20260930.csv"]}}
      ]
    },
    {
      "id": "S05", "name": "거래집계_상품별_다운로드",
      "actions": [
        {"click": "#menu-daily-trades"},
        {"fill": "#start-date", "value": "2026-11-01"},
        {"fill": "#end-date", "value": "2026-11-18"},
        {"select": "#product-type", "value": "주식"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"start-date": "2026-11-01", "end-date": "2026-11-18", "product-type": "주식"}, "expect": {"download": ["일별거래집계_20261101_20261118.csv"]}},
        {"inputs": {"start-date": "2026-10-01", "end-date": "2026-10-15", "product-type": "채권"}, "expect": {"download": ["일별거래집계_20261001_20261015.csv"]}},
        {"inputs": {"start-date": "2026-09-01", "end-date": "2026-09-05", "product-type": "펀드"}, "expect": {"download": ["일별거래집계_20260901_20260905.csv"]}}
      ]
    },
    {
      "id": "S06", "name": "거래집계_하루_다운로드",
      "actions": [
        {"click": "#menu-daily-trades"},
        {"fill": "#start-date", "value": "2026-11-17"},
        {"fill": "#end-date", "value": "2026-11-17"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"start-date": "2026-11-17", "end-date": "2026-11-17"}, "expect": {"download": ["일별거래집계_20261117_20261117.csv"]}},
        {"inputs": {"start-date": "2026-11-16", "end-date": "2026-11-16"}, "expect": {"download": ["일별거래집계_20261116_20261116.csv"]}},
        {"inputs": {"start-date": "2026-11-15", "end-date": "2026-11-15"}, "expect": {"stop": "no_result"}, "note": "일요일이라 거래 없음"}
      ]
    },
    {
      "id": "S07", "name": "점검결과_등록",
      "actions": [
        {"click": "#menu-inspection-new"},
        {"select": "#vendor-select", "label": "샘플IT서비스 (IT)"},
        {"fill": "#inspection-date", "value": "2026-11-18"},
        {"check": "#result-1"},
        {"click": "#save-button"}
      ],
      "input_sets": [
        {"inputs": {"vendor-select": "샘플IT서비스", "inspection-date": "2026-11-18", "inspection_result": "적합"}, "expect": {"message": "샘플IT서비스, 2026-11-18, 적합"}},
        {"inputs": {"vendor-select": "가나다시스템", "inspection-date": "2026-11-17", "inspection_result": "보완 필요"}, "expect": {"message": "가나다시스템, 2026-11-17, 보완 필요"}},
        {"inputs": {"vendor-select": "든든보안", "inspection-date": "2026-11-16", "inspection_result": "부적합"}, "expect": {"message": "든든보안, 2026-11-16, 부적합"}}
      ]
    },
    {
      "id": "S08", "name": "점검결과_비고포함_등록",
      "actions": [
        {"click": "#menu-inspection-new"},
        {"select": "#vendor-select", "label": "하늘콜센터 (콜센터)"},
        {"fill": "#inspection-date", "value": "2026-11-18"},
        {"check": "#result-2"},
        {"fill": "#inspection-note", "value": "녹취 보관 점검표 미제출"},
        {"click": "#save-button"}
      ],
      "input_sets": [
        {"inputs": {"vendor-select": "하늘콜센터", "inspection-date": "2026-11-18", "inspection_result": "보완 필요", "inspection-note": "녹취 보관 점검표 미제출"}, "expect": {"message": "하늘콜센터, 2026-11-18, 보완 필요"}},
        {"inputs": {"vendor-select": "바른고객센터", "inspection-date": "2026-11-17", "inspection_result": "보완 필요", "inspection-note": "상담 품질 평가 누락"}, "expect": {"message": "바른고객센터, 2026-11-17, 보완 필요"}},
        {"inputs": {"vendor-select": "빠른인쇄", "inspection-date": "2026-11-16", "inspection_result": "적합", "inspection-note": "특이사항 없음"}, "expect": {"message": "빠른인쇄, 2026-11-16, 적합"}}
      ]
    },
    {
      "id": "S09", "name": "점검현황과_거래집계_연속다운로드",
      "actions": [
        {"click": "#menu-inspection-status"},
        {"fill": "#inquiry-date", "value": "2026-11-18"},
        {"click": "#search-button"},
        {"download": "#download-csv"},
        {"click": "#home-link"},
        {"click": "#menu-daily-trades"},
        {"fill": "#start-date", "value": "2026-11-01"},
        {"fill": "#end-date", "value": "2026-11-18"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"inquiry-date": "2026-11-18", "start-date": "2026-11-01", "end-date": "2026-11-18"}, "expect": {"download": ["위탁업체점검_20261118.csv", "일별거래집계_20261101_20261118.csv"]}},
        {"inputs": {"inquiry-date": "2026-10-31", "start-date": "2026-10-01", "end-date": "2026-10-31"}, "expect": {"download": ["위탁업체점검_20261031.csv", "일별거래집계_20261001_20261031.csv"]}},
        {"inputs": {"inquiry-date": "2026-09-30", "start-date": "2026-09-01", "end-date": "2026-09-30"}, "expect": {"download": ["위탁업체점검_20260930.csv", "일별거래집계_20260901_20260930.csv"]}}
      ]
    },
    {
      "id": "S10", "name": "점검결과_등록후_현황다운로드",
      "actions": [
        {"click": "#menu-inspection-new"},
        {"select": "#vendor-select", "label": "다온시설관리 (시설관리)"},
        {"fill": "#inspection-date", "value": "2026-11-18"},
        {"check": "#result-3"},
        {"click": "#save-button"},
        {"click": "#home-link"},
        {"click": "#menu-inspection-status"},
        {"fill": "#inquiry-date", "value": "2026-11-18"},
        {"select": "#vendor-status", "value": "부적합"},
        {"click": "#search-button"},
        {"download": "#download-csv"}
      ],
      "input_sets": [
        {"inputs": {"vendor-select": "다온시설관리", "inspection-date": "2026-11-18", "inspection_result": "부적합", "inquiry-date": "2026-11-18", "vendor-status": "부적합"}, "expect": {"message": "다온시설관리, 2026-11-18, 부적합", "download": ["위탁업체점검_20261118.csv"]}},
        {"inputs": {"vendor-select": "새솔환경", "inspection-date": "2026-11-17", "inspection_result": "보완 필요", "inquiry-date": "2026-11-17", "vendor-status": "보완 필요"}, "expect": {"message": "새솔환경, 2026-11-17, 보완 필요", "download": ["위탁업체점검_20261117.csv"]}},
        {"inputs": {"vendor-select": "지킴이경비", "inspection-date": "2026-11-16", "inspection_result": "적합", "inquiry-date": "2026-11-16", "vendor-status": "적합"}, "expect": {"message": "지킴이경비, 2026-11-16, 적합", "download": ["위탁업체점검_20261116.csv"]}}
      ]
    }
  ]
}
