# ── AI 연결 ───────────────────────────────────────────────
# 연결 방식: gemini(시험·개발용, 외부 서비스) | openai(사내 AI — OpenAI 호환 API)
#   실제 업무(내부 정보)에 쓸 때는 openai로 바꾸고 사내 AI 주소를 넣으세요.
LLM_PROVIDER=gemini

# API 키 (gemini: Google AI Studio https://aistudio.google.com 에서 발급 / openai: 사내에서 받은 키, 없으면 비움)
LLM_API_KEY=

# 사용할 모델. 쓸 수 있는 이름은 `python -m analyzer.llm_client --list`로 확인
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite

# ── 사내 AI(openai 방식)일 때만 ──────────────────────────────
# 사내 AI 주소 (/chat/completions 앞까지). 예: https://ai.사내도메인/v1
LLM_BASE_URL=
# 이미지를 못 받는 모델이면 false (스크린샷 없이 글만 보냄)
LLM_SEND_IMAGES=true
# 사내 인증서 때문에 연결이 안 될 때만 false
LLM_VERIFY_SSL=true
